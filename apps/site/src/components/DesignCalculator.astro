---
import { getDesignPackages } from '../lib/content';

const { packages, extraRoomRate, comparableDraftspersonPrice } = await getDesignPackages();
const defaultPackage = packages.find((p: { popular: boolean }) => p.popular) ?? packages[0];
---

<div id="design-calculator" class="rounded-3xl border border-ink-200 bg-white p-6 shadow-xl shadow-ink-200/50 lg:p-8" data-extra-room-rate={extraRoomRate}>
	<div class="grid gap-8 lg:grid-cols-12 lg:items-start">
		<div class="lg:col-span-7">
			<h3 class="mb-2 text-2xl font-bold text-ink-900">Design Your Kit Home</h3>
			<p class="mb-6 text-sm text-ink-600">
				Get architectural floor plans and 3D renders tailored to your block — before you commit to a build.
			</p>
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
				<div class="rounded-xl border border-ink-100 bg-ink-50 p-4">
					<p class="mb-1 text-sm font-bold text-ink-900">Architectural Layouts</p>
					<p class="text-xs text-ink-600">Fully scaled floor plans tailored to your site.</p>
				</div>
				<div class="rounded-xl border border-ink-100 bg-ink-50 p-4">
					<p class="mb-1 text-sm font-bold text-ink-900">Exterior 3D Renders</p>
					<p class="text-xs text-ink-600">High-resolution visuals of your home.</p>
				</div>
				<div class="rounded-xl border border-ink-100 bg-ink-50 p-4">
					<p class="mb-1 text-sm font-bold text-ink-900">Site-Ready Docs</p>
					<p class="text-xs text-ink-600">Plans prepared for council and builder conversations.</p>
				</div>
			</div>
		</div>

		<div class="lg:col-span-5">
			<div class="space-y-3">
				<p class="text-sm font-semibold text-ink-900">Select Base Package</p>
				<div class="grid grid-cols-1 gap-3 sm:grid-cols-3" id="package-options">
					{
						packages.map((pkg: { key: string; title: string; beds: number; baths: number; price: number; popular: boolean }) => (
							<button
								type="button"
								data-package-key={pkg.key}
								data-price={pkg.price}
								class:list={[
									'package-option relative rounded-xl border p-4 text-left transition-all',
									pkg.key === defaultPackage.key ? 'border-brand-200 bg-brand-50 ring-1 ring-brand-600' : 'border-ink-200 bg-white hover:border-brand-300',
								]}
							>
								{pkg.popular && (
									<span class="absolute -top-2 left-1/2 -translate-x-1/2 rounded-full bg-brand-600 px-2 py-0.5 text-[9px] font-bold tracking-wider text-white uppercase whitespace-nowrap shadow-sm">
										Popular
									</span>
								)}
								<p class="mb-1.5 text-sm font-bold text-ink-900">{pkg.title}</p>
								<p class="mb-2 text-[11px] text-ink-500">{pkg.beds} Bed &middot; {pkg.baths} Bath</p>
								<p class="text-base font-black text-ink-900">${pkg.price}</p>
							</button>
						))
					}
				</div>

				<label for="extra-rooms" class="block pt-2 text-sm font-semibold text-ink-900">Additional Rooms</label>
				<select id="extra-rooms" class="h-12 w-full rounded-lg border border-ink-200 bg-ink-50 px-3 text-sm outline-none focus:border-brand-600 focus:ring-1 focus:ring-brand-600">
					{
						Array.from({ length: 9 }).map((_, num) => (
							<option value={num}>{num === 0 ? 'No extra rooms' : `+${num} Extra Room${num > 1 ? 's' : ''} (+$${num * extraRoomRate})`}</option>
						))
					}
				</select>
			</div>

			<div class="mt-6 border-t border-ink-100 pt-6">
				<div class="mb-4 flex items-end justify-between">
					<div>
						<p class="mb-1 text-xs font-semibold tracking-wider text-ink-500 uppercase">Your Design Package</p>
						<p class="text-[11px] text-ink-500">
							Comparable draftsperson: <span class="text-ink-400 line-through">${comparableDraftspersonPrice}+</span>
						</p>
					</div>
					<div class="flex items-baseline gap-1.5">
						<span id="total-price" class="text-4xl font-extrabold tracking-tight text-ink-900">${defaultPackage.price}</span>
						<span class="text-xs font-medium text-ink-500">AUD</span>
					</div>
				</div>

				<div class="mb-5 rounded-lg border border-brand-100 bg-brand-50 p-3">
					<p class="text-[13px] font-medium text-brand-800">
						100% of your design fee is credited when you order your kit home.
					</p>
				</div>

				<a
					id="calculator-cta"
					href="/get-started"
					class="btn-primary w-full py-3.5 text-base"
				>
					<span id="calculator-cta-label">Start My Design – ${defaultPackage.price}</span>
				</a>
			</div>
		</div>
	</div>
</div>

<script>
	const container = document.getElementById('design-calculator');
	const extraRoomRate = Number(container?.getAttribute('data-extra-room-rate')) || 30;

	const optionButtons = document.querySelectorAll<HTMLButtonElement>('.package-option');
	const extraRoomsSelect = document.getElementById('extra-rooms') as HTMLSelectElement;
	const totalPriceEl = document.getElementById('total-price') as HTMLSpanElement;
	const ctaLabel = document.getElementById('calculator-cta-label') as HTMLSpanElement;

	let selectedPrice = Number(
		document.querySelector<HTMLButtonElement>('.package-option.border-brand-200')?.dataset.price ?? 0
	);

	function updateTotal() {
		const extraRooms = Number(extraRoomsSelect.value) || 0;
		const total = selectedPrice + extraRooms * extraRoomRate;
		totalPriceEl.textContent = `$${total}`;
		ctaLabel.textContent = `Start My Design – $${total}`;
	}

	optionButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			optionButtons.forEach((b) => {
				b.classList.remove('border-brand-200', 'bg-brand-50', 'ring-1', 'ring-brand-600');
				b.classList.add('border-ink-200', 'bg-white');
			});
			btn.classList.remove('border-ink-200', 'bg-white');
			btn.classList.add('border-brand-200', 'bg-brand-50', 'ring-1', 'ring-brand-600');
			selectedPrice = Number(btn.dataset.price) || 0;
			updateTotal();
		});
	});

	extraRoomsSelect.addEventListener('change', updateTotal);
</script>
