---
interface Props {
	business: {
		name: string;
		logo: string;
		phone: string;
		phoneHref: string;
		emailGeneral: string;
		hours: string;
		serviceArea: string;
		footerNav: { label: string; href: string }[];
	};
}

const { business } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-ink-900 text-ink-300">
	<div class="container-page py-16">
		<div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
			<div class="lg:col-span-2">
				<div class="mb-6 inline-block rounded-xl bg-white p-4 shadow-sm">
					<img src={business.logo} alt={`${business.name} logo`} class="h-16 w-auto object-contain md:h-20" />
				</div>
				<p class="mb-6 max-w-md text-sm text-ink-400">
					100% custom-engineered building solutions with precision-crafted materials and nationwide delivery
					across Australia.
				</p>
				<!-- TODO(business): old site said "Australian Standards Certified",
				     which implies a specific formal certification. Softened to a
				     process claim consistent with the rest of the site - if you hold
				     an actual certification, name it here instead. -->
				<div class="flex items-center gap-2 text-sm text-ink-400">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5 text-brand-400"><path stroke-linecap="round" stroke-linejoin="round" d="m9 12.75 3 3 7.5-7.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
					<span>Engineered to Australian Standards</span>
				</div>
			</div>

			<div>
				<h3 class="mb-6 text-lg font-semibold text-white">Quick Links</h3>
				<ul class="space-y-3">
					{
						business.footerNav.map((link) => (
							<li>
								<a href={link.href} class="text-sm hover:text-brand-400 transition-colors">
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h3 class="mb-6 text-lg font-semibold text-white">Contact Us</h3>
				<ul class="space-y-4 text-sm">
					<li class="flex items-start gap-3">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 h-5 w-5 flex-shrink-0 text-brand-400"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h1.5a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106a1.125 1.125 0 0 0-1.173.417l-.97 1.293a1.125 1.125 0 0 1-1.21.38 12.035 12.035 0 0 1-7.143-7.143 1.125 1.125 0 0 1 .38-1.21l1.293-.97a1.125 1.125 0 0 0 .417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
						<div>
							<a href={business.phoneHref} class="block font-medium text-white hover:text-brand-400 transition-colors">
								{business.phone}
							</a>
							<p class="mt-1 text-xs text-ink-400">{business.hours}</p>
						</div>
					</li>
					<li class="flex items-start gap-3">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 h-5 w-5 flex-shrink-0 text-brand-400"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" /></svg>
						<a href={`mailto:${business.emailGeneral}`} class="hover:text-brand-400 transition-colors">
							{business.emailGeneral}
						</a>
					</li>
					<li class="flex items-start gap-3">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 h-5 w-5 flex-shrink-0 text-brand-400"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
						<span>{business.serviceArea}</span>
					</li>
				</ul>
			</div>
		</div>

		<div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-ink-800 pt-8 md:flex-row">
			<p class="text-sm text-ink-400">
				&copy; {year} {business.name}. All rights reserved. Australian owned and operated.
			</p>
			<div class="flex items-center gap-6 text-sm text-ink-400">
				<a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a>
				<a href="/terms" class="hover:text-white transition-colors">Terms and Conditions</a>
			</div>
		</div>
	</div>
</footer>
