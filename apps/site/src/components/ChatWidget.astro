---
// Talks to the existing apps/api /chat endpoints (already secured — see
// apps/api/src/routes/chat.js and middleware/admin-auth.js on main).
// Defaults to /hcgi/api for backward compatibility with the legacy hCGI
// reverse proxy; can be overridden by setting PUBLIC_API_URL at build/deploy time.
---

<div id="chat-widget" class="fixed bottom-6 right-6 z-50 flex flex-col items-end">
	<div id="chat-panel" class="mb-4 hidden h-[500px] w-[350px] flex-col overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-2xl">
		<div class="flex items-center justify-between bg-ink-900 p-4 text-white">
			<div>
				<h3 class="text-lg font-bold leading-none text-white">Support Chat</h3>
				<p class="mt-1 text-sm text-ink-300">We typically reply in minutes</p>
			</div>
			<button id="chat-close" type="button" aria-label="Close chat" class="p-1 text-ink-300 hover:text-white">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
			</button>
		</div>

		<div id="chat-name-gate" class="flex flex-1 flex-col items-center justify-center gap-4 bg-ink-50 px-6 text-center">
			<h4 class="font-bold text-ink-900">Welcome!</h4>
			<p class="text-sm text-ink-500">Please enter your name to start chatting with our team.</p>
			<form id="chat-name-form" class="w-full space-y-3">
				<input
					id="chat-name-input"
					type="text"
					placeholder="Your Name"
					required
					class="w-full rounded-xl border border-ink-200 px-4 py-3 text-ink-900 outline-none transition-all focus:border-ink-900 focus:ring-1 focus:ring-ink-900"
				/>
				<button type="submit" class="w-full rounded-xl bg-ink-900 py-3 font-semibold text-white shadow-sm hover:bg-ink-800">
					Start Chat
				</button>
			</form>
		</div>

		<div id="chat-messages" class="hidden flex-1 flex-col gap-3 overflow-y-auto bg-ink-50 p-4"></div>

		<form id="chat-send-form" class="hidden border-t border-ink-200 bg-white p-3">
			<div class="flex items-center gap-2">
				<input
					id="chat-message-input"
					type="text"
					placeholder="Type your message..."
					class="flex-1 rounded-full border border-transparent bg-ink-100 px-4 py-2.5 text-sm text-ink-900 outline-none transition-all focus:border-ink-900 focus:bg-white focus:ring-1 focus:ring-ink-900"
				/>
				<button type="submit" aria-label="Send" class="flex-shrink-0 rounded-full bg-ink-900 p-2.5 text-white shadow-sm hover:bg-ink-800">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.126A59.768 59.768 0 0 1 21.485 12 59.77 59.77 0 0 1 3.27 20.876L5.999 12Zm0 0h7.5" /></svg>
				</button>
			</div>
		</form>
	</div>

	<button
		id="chat-toggle"
		type="button"
		aria-label="Toggle chat"
		class="flex h-14 w-14 items-center justify-center rounded-full bg-ink-900 text-white shadow-xl transition-transform hover:bg-ink-800 active:scale-95"
	>
		<svg id="chat-icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" /></svg>
		<svg id="chat-icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
	</button>
</div>

<script>
	const API_BASE = import.meta.env.PUBLIC_API_URL || '/hcgi/api';

	const panel = document.getElementById('chat-panel') as HTMLDivElement;
	const toggle = document.getElementById('chat-toggle') as HTMLButtonElement;
	const closeBtn = document.getElementById('chat-close') as HTMLButtonElement;
	const iconOpen = document.getElementById('chat-icon-open') as HTMLElement;
	const iconClose = document.getElementById('chat-icon-close') as HTMLElement;
	const nameGate = document.getElementById('chat-name-gate') as HTMLDivElement;
	const nameForm = document.getElementById('chat-name-form') as HTMLFormElement;
	const nameInput = document.getElementById('chat-name-input') as HTMLInputElement;
	const messagesEl = document.getElementById('chat-messages') as HTMLDivElement;
	const sendForm = document.getElementById('chat-send-form') as HTMLFormElement;
	const messageInput = document.getElementById('chat-message-input') as HTMLInputElement;

	let sessionId = localStorage.getItem('chatSessionId');
	if (!sessionId) {
		sessionId = crypto.randomUUID();
		localStorage.setItem('chatSessionId', sessionId);
	}
	let customerName = localStorage.getItem('chatCustomerName') || '';
	let isOpen = false;
	let pollTimer: ReturnType<typeof setInterval> | null = null;

	function renderMessages(messages: Array<{ id: string; message: string; senderType: string; createdAt?: string }>) {
		messagesEl.innerHTML = '';
		if (messages.length === 0) {
			messagesEl.innerHTML =
				'<div class="my-auto rounded-xl border border-ink-200 bg-white p-4 text-center text-sm text-ink-500">Send a message to start the conversation.</div>';
			return;
		}
		for (const msg of messages) {
			const row = document.createElement('div');
			row.className = `flex w-full ${msg.senderType === 'admin' ? 'justify-start' : 'justify-end'}`;
			const bubble = document.createElement('div');
			bubble.className =
				msg.senderType === 'admin'
					? 'max-w-[85%] rounded-2xl rounded-tl-none border border-ink-200 bg-white p-3 text-sm text-ink-900 shadow-sm'
					: 'max-w-[85%] rounded-2xl rounded-tr-none bg-ink-900 p-3 text-sm text-white shadow-sm';
			bubble.textContent = msg.message;
			row.appendChild(bubble);
			messagesEl.appendChild(row);
		}
		messagesEl.scrollTop = messagesEl.scrollHeight;
	}

	async function fetchMessages() {
		try {
			const res = await fetch(`${API_BASE}/chat/messages?sessionId=${sessionId}`);
			if (!res.ok) return;
			const data = await res.json();
			if (Array.isArray(data)) renderMessages(data);
		} catch {
			// Network hiccup — the next poll tick will retry.
		}
	}

	function startPolling() {
		fetchMessages();
		pollTimer = setInterval(fetchMessages, 2000);
	}

	function stopPolling() {
		if (pollTimer) clearInterval(pollTimer);
		pollTimer = null;
	}

	function openPanel() {
		isOpen = true;
		panel.classList.remove('hidden');
		panel.classList.add('flex');
		iconOpen.classList.add('hidden');
		iconClose.classList.remove('hidden');
		if (customerName) startPolling();
	}

	function closePanel() {
		isOpen = false;
		panel.classList.add('hidden');
		panel.classList.remove('flex');
		iconOpen.classList.remove('hidden');
		iconClose.classList.add('hidden');
		stopPolling();
	}

	toggle.addEventListener('click', () => (isOpen ? closePanel() : openPanel()));
	closeBtn.addEventListener('click', closePanel);

	if (customerName) {
		nameGate.classList.add('hidden');
		messagesEl.classList.remove('hidden');
		messagesEl.classList.add('flex');
		sendForm.classList.remove('hidden');
	}

	nameForm.addEventListener('submit', (e) => {
		e.preventDefault();
		const name = nameInput.value.trim();
		if (!name) return;
		customerName = name;
		localStorage.setItem('chatCustomerName', name);
		nameGate.classList.add('hidden');
		messagesEl.classList.remove('hidden');
		messagesEl.classList.add('flex');
		sendForm.classList.remove('hidden');
		startPolling();
	});

	sendForm.addEventListener('submit', async (e) => {
		e.preventDefault();
		const message = messageInput.value.trim();
		if (!message) return;
		messageInput.value = '';
		try {
			await fetch(`${API_BASE}/chat/messages`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ sessionId, message, senderType: 'customer', customerName }),
			});
			fetchMessages();
		} catch {
			messageInput.value = message;
		}
	});
</script>
