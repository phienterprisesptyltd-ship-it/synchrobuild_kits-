---
interface Props {
	image: string;
	title: string;
	category: string;
	description: string;
}

const { image, title, category, description } = Astro.props;
---

<div class="group overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-sm transition-shadow duration-200 hover:shadow-xl">
	<div class="relative aspect-[4/3] overflow-hidden bg-ink-100">
		<img
			src={image}
			alt={title}
			loading="lazy"
			class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
		/>
		<span class="absolute top-3 left-3 rounded-full bg-white/95 px-3 py-1 text-[10px] font-bold tracking-wider text-ink-800 uppercase shadow-sm">
			{category}
		</span>
	</div>
	<div class="p-5">
		<h3 class="mb-1.5 font-bold text-ink-900">{title}</h3>
		<p class="line-clamp-2 text-sm text-ink-500">{description}</p>
	</div>
</div>
