---
interface Props {
	placeholder: boolean;
	name?: string;
	rating?: number;
	quote?: string;
	project?: string;
	avatar?: string;
}

const { placeholder, name, rating, quote, project, avatar } = Astro.props;
---

{
	placeholder ? (
		<div class="flex h-full flex-col items-center justify-center rounded-2xl border border-dashed border-ink-300 bg-ink-50 p-6 text-center">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-3 h-8 w-8 text-ink-300">
				<path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3.75h6m-9-9h12A2.25 2.25 0 0 1 21 5.25v9a2.25 2.25 0 0 1-2.25 2.25H8.25l-3.75 3.75V5.25A2.25 2.25 0 0 1 4.5 3Z" />
			</svg>
			<p class="text-sm font-semibold text-ink-500">Customer testimonial to be added</p>
			<p class="mt-1 text-xs text-ink-400">Real customer reviews coming soon</p>
		</div>
	) : (
		<figure class="flex h-full flex-col rounded-2xl border border-ink-200 bg-white p-6 shadow-sm">
			<div class="mb-4 flex items-center gap-0.5" aria-label={`${rating} out of 5 stars`}>
				{Array.from({ length: 5 }).map((_, i) => (
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 20 20"
						fill={i < (rating ?? 0) ? 'currentColor' : 'none'}
						stroke="currentColor"
						stroke-width="1.5"
						class="h-4 w-4 text-amber-400"
					>
						<path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1 1 5.8L10 14.9l-5.21 2.74 1-5.8-4.21-4.1 5.82-.85L10 1.5z" />
					</svg>
				))}
			</div>
			<blockquote class="flex-grow text-sm leading-relaxed text-ink-700">&ldquo;{quote}&rdquo;</blockquote>
			<figcaption class="mt-5 flex items-center gap-3 border-t border-ink-100 pt-5">
				{avatar && <img src={avatar} alt="" loading="lazy" class="h-10 w-10 rounded-full object-cover" />}
				<div>
					<p class="text-sm font-bold text-ink-900">{name}</p>
					<p class="text-xs text-ink-500">{project}</p>
				</div>
			</figcaption>
		</figure>
	)
}
