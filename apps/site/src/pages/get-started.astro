---
import Layout from '../layouts/Layout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { getBusiness } from '../lib/content';

const business = await getBusiness();

const commitments = [
	{
		title: 'Supply-Only Model',
		description:
			'We focus exclusively on engineering and supplying premium materials for serious owner-builders and their contractors.',
	},
	{
		title: 'Transparent Design Fees',
		description:
			'Clear, upfront pricing. Fees may vary based on project scope and complexity, ensuring no hidden costs.',
	},
	{
		title: 'Precision Engineering',
		description: 'Every component is engineered to exact Australian standards for a perfect fit on site.',
	},
	{
		title: '5-Day Technical Support',
		description: 'Expert guidance available 5 days a week throughout your entire build journey.',
	},
];
---

<Layout
	title="Get Started - Synchro Build"
	description="Ready to build your custom home? Submit an inquiry to Synchro Build and receive a consultation with our engineering team, typically within 24-48 hours."
>
	<section class="bg-gradient-to-br from-brand-600 to-indigo-700 py-16 text-white">
		<div class="container-page text-center">
			<h1 class="mb-6 text-5xl font-bold text-white md:text-6xl">Let's Build Your Vision</h1>
			<p class="mx-auto max-w-3xl text-xl text-brand-100">
				Share your project details with us and discover how custom engineering can transform your design into
				reality. Upload your plans or start a custom consultation today.
			</p>
		</div>
	</section>

	<section class="section bg-ink-50">
		<div class="container-page">
			<div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-12">
				<div class="lg:col-span-5">
					<div class="lg:sticky lg:top-28">
						<h2 class="mb-6 text-3xl font-bold text-ink-900 md:text-4xl">The Synchro Build Commitment</h2>
						<p class="mb-8 text-lg leading-relaxed text-ink-700">
							We partner with serious owner-builders who demand quality, precision, and reliability. When
							you submit an inquiry, you're taking the first step toward a professionally engineered build.
						</p>

						<div class="mb-8 space-y-6">
							{
								commitments.map((item) => (
									<div class="flex items-start gap-4 rounded-xl border border-ink-100 bg-white p-5 shadow-sm">
										<div class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-brand-500" />
										<div>
											<h3 class="mb-1 text-lg font-bold text-ink-900">{item.title}</h3>
											<p class="text-sm leading-relaxed text-ink-600">{item.description}</p>
										</div>
									</div>
								))
							}
						</div>

						<div class="rounded-xl bg-brand-600 p-6 text-white shadow-lg">
							<h3 class="mb-2 text-xl font-bold text-white">What Happens Next?</h3>
							<ul class="mt-4 space-y-3 text-brand-50">
								<li>We review your plans and project brief</li>
								<li>Our engineers assess structural requirements</li>
								<li>We provide a detailed consultation within 24-48 hours</li>
							</ul>
						</div>
					</div>
				</div>

				<div class="lg:col-span-7">
					<div class="mb-8 flex flex-col items-center justify-between gap-4 rounded-xl border border-brand-100 bg-brand-50 p-6 shadow-sm sm:flex-row">
						<div>
							<h3 class="mb-1 text-lg font-bold text-ink-900">Or reach out directly at</h3>
							<p class="text-sm text-ink-600">Skip the form and email our sales team with your project details.</p>
						</div>
						<a href={`mailto:${business.emailGeneral}`} class="btn-primary flex-shrink-0 whitespace-nowrap">
							{business.emailGeneral}
						</a>
					</div>

					<InquiryForm />
				</div>
			</div>
		</div>
	</section>

	<section class="section bg-white">
		<div class="container-page mx-auto max-w-4xl text-center">
			<h2 class="mb-6 text-3xl font-bold md:text-4xl">Prefer to Talk First?</h2>
			<p class="mb-8 text-lg text-ink-700">
				We understand that every project is unique. If you'd like to discuss your ideas before submitting a
				formal inquiry, our team is here to help.
			</p>
			<div class="grid gap-6 md:grid-cols-2">
				<div class="flex flex-col items-center justify-center rounded-xl border border-ink-200 p-8 transition-colors hover:border-brand-300">
					<h3 class="mb-3 font-bold text-ink-900">Call Us</h3>
					<a href={business.phoneHref} class="mb-3 text-3xl font-bold text-brand-600 hover:text-brand-700">
						{business.phone}
					</a>
					<p class="text-sm text-ink-600">{business.hours}</p>
				</div>
				<div class="flex flex-col items-center justify-center rounded-xl border border-ink-200 p-8 transition-colors hover:border-brand-300">
					<h3 class="mb-3 font-bold text-ink-900">Email Us</h3>
					<a href={`mailto:${business.emailGeneral}`} class="mb-3 text-xl font-semibold text-brand-600 hover:text-brand-700">
						{business.emailGeneral}
					</a>
					<p class="text-sm text-ink-600">We respond within 24 hours</p>
				</div>
			</div>
		</div>
	</section>
</Layout>
