---
import Layout from '../layouts/Layout.astro';
import { getSupplyProcess } from '../lib/content';

const supplyProcess = await getSupplyProcess();

const advantages = [
	{ title: 'Design Freedom', description: 'Build exactly what you want, not what a catalog offers. Your design, your way.' },
	{ title: 'Precision Engineering', description: 'Every component calculated and manufactured to exact specifications for perfect fit.' },
	{ title: 'Premium Materials', description: 'Truecore® steel and Australian-standard materials engineered for durability.' },
	{ title: 'Expert Support', description: '5-day technical support throughout your build journey from experienced engineers.' },
];
---

<Layout
	title="Our Process - Synchro Build"
	description="Discover how Synchro Build transforms your design concept into a precision-engineered building kit. From engineering analysis to nationwide delivery with 5-day support."
>
	<section class="bg-gradient-to-br from-brand-600 to-indigo-700 py-16 text-white">
		<div class="container-page mx-auto max-w-4xl text-center">
			<h1 class="mb-6 text-5xl font-bold text-white md:text-6xl">{supplyProcess.heading}</h1>
			<p class="text-xl text-brand-100">{supplyProcess.intro}</p>
		</div>
	</section>

	<section class="section bg-white">
		<div class="container-page mx-auto max-w-5xl space-y-16">
			{
				supplyProcess.steps.map((step: { stage: number; title: string; subtitle: string; description: string; details: string[]; image?: string; imageCaption?: string }) => (
					<div class="flex flex-col gap-8 md:flex-row md:items-start">
						<div class="flex h-20 w-20 flex-shrink-0 items-center justify-center rounded-2xl bg-brand-600 text-2xl font-black text-white shadow-lg">
							{step.stage}
						</div>
						<div class="w-full flex-1">
							<span class="text-sm font-bold tracking-wide text-ink-500 uppercase">Stage {step.stage}</span>
							<h2 class="mt-1 text-3xl font-bold text-ink-900">{step.title}</h2>
							<p class="mt-1 text-lg font-semibold text-brand-600">{step.subtitle}</p>
							<p class="mt-4 mb-6 text-lg leading-relaxed text-ink-700">{step.description}</p>

							<div class="grid gap-6 lg:grid-cols-2">
								<div class="h-full rounded-xl border border-ink-200 bg-ink-50 p-6">
									<h3 class="mb-4 flex items-center gap-2 font-semibold text-ink-900">What's Included</h3>
									<ul class="space-y-3">
										{step.details.map((detail) => (
											<li class="flex items-start gap-3 text-sm text-ink-700">
												<span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-500" />
												{detail}
											</li>
										))}
									</ul>
								</div>
								{step.image && (
									<div class="relative h-full min-h-[250px] overflow-hidden rounded-xl border border-ink-100 shadow-md">
										<img src={step.image} alt={step.title} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
										{step.imageCaption && (
											<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-4 text-sm font-medium text-white">
												{step.imageCaption}
											</div>
										)}
									</div>
								)}
							</div>
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section class="section bg-ink-50">
		<div class="container-page">
			<div class="mb-12 text-center">
				<h2 class="mb-4 text-4xl font-bold md:text-5xl">Why Choose Custom Engineering?</h2>
				<p class="mx-auto max-w-3xl text-xl text-ink-600">
					The difference between pre-designed solutions and true custom engineering
				</p>
			</div>
			<div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-2 lg:grid-cols-4">
				{
					advantages.map((advantage) => (
						<div class="rounded-xl border border-ink-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-lg">
							<h3 class="mb-3 text-xl font-bold text-ink-900">{advantage.title}</h3>
							<p class="text-ink-600">{advantage.description}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="section bg-gradient-to-br from-brand-600 to-indigo-700">
		<div class="container-page mx-auto max-w-4xl">
			<div class="rounded-2xl border border-white/20 bg-white/10 p-8 backdrop-blur-sm md:p-12">
				<h2 class="mb-6 text-3xl font-bold text-white md:text-4xl">5-Day Technical Support</h2>
				<p class="mb-8 text-xl leading-relaxed text-brand-100">
					Our commitment doesn't end at delivery. Throughout your build, our experienced engineers are
					available to answer questions, provide guidance, and ensure your project stays on track. From
					foundation to final touches, we're with you every step of the way.
				</p>
				<div class="mb-8 grid gap-6 md:grid-cols-3">
					<div class="text-center">
						<div class="mb-2 text-4xl font-bold text-white">5 Days</div>
						<div class="text-brand-100">Weekly Support</div>
					</div>
					<div class="text-center">
						<div class="mb-2 text-4xl font-bold text-white">100%</div>
						<div class="text-brand-100">Custom Solutions</div>
					</div>
					<div class="text-center">
						<div class="mb-2 text-4xl font-bold text-white">24-48h</div>
						<div class="text-brand-100">Response Time</div>
					</div>
				</div>
				<div class="text-center">
					<a href="/get-started" class="btn-secondary">
						Start Your Project Today
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" /></svg>
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>
