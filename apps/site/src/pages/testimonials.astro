---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TestimonialCard from '../components/TestimonialCard.astro';

// Filter out placeholder testimonials; only show real customer feedback
const allTestimonials = await getCollection('testimonials');
const testimonials = allTestimonials.filter((t) => !t.data.placeholder);

// TODO(business): temporary noindex while there are zero genuine
// testimonials - this clears itself automatically once real entries exist
// (placeholder: false in src/content/testimonials/), so no manual removal
// is needed. Also excluded from the sitemap in astro.config.mjs; remove
// that exclusion when real testimonials land.
const hasRealTestimonials = testimonials.length > 0;

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: new URL('/', Astro.site).toString(),
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Testimonials',
			item: new URL('/testimonials', Astro.site).toString(),
		},
	],
};
---

<Layout
	title="Testimonials - Synchro Build"
	description="Read what our clients have to say about their experience with Synchro Build's custom-engineered building kits and support."
	robots={hasRealTestimonials ? undefined : 'noindex, follow'}
>
	<Fragment slot="head">
		<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
	</Fragment>
	<div class="border-b border-ink-100 bg-ink-50 py-6">
		<div class="container-page">
			<nav aria-label="Breadcrumb">
				<ol class="flex items-center gap-2 text-sm">
					<li><a href="/" class="text-brand-600 hover:text-brand-700">Home</a></li>
					<li class="text-ink-400">/</li>
					<li class="text-ink-600" aria-current="page">Testimonials</li>
				</ol>
			</nav>
		</div>
	</div>

	<section class="relative flex min-h-[70vh] items-center justify-center overflow-hidden">
		<div class="absolute inset-0">
			<img
				src="https://horizons-cdn.hostinger.com/0e3c4b12-5c30-4fff-a4c0-65b7e6df4b83/f1ea4035684987239c0d3a081a0af9c2.jpg"
				alt="Beautifully constructed modern home interior"
				class="h-full w-full object-cover"
			/>
			<div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/70"></div>
		</div>

		<div class="relative z-10 container-page pt-20 text-center">
			<span class="mb-6 inline-flex items-center justify-center rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-medium tracking-wide text-white uppercase backdrop-blur-md">
				Client Stories
			</span>
			<h1 class="mb-6 text-5xl leading-tight font-bold text-white drop-shadow-lg md:text-7xl">
				Built on Trust,<br />Engineered for Excellence
			</h1>
			<p class="mx-auto max-w-3xl text-xl font-medium text-gray-200 drop-shadow-md md:text-2xl">
				{testimonials.length > 0 ? 'Hear from the owner-builders and contractors who have worked with Synchro Build.' : 'Customer testimonials coming soon.'}
			</p>
		</div>
	</section>

	<section class="section bg-ink-50">
		<div class="container-page">
			<div class="mb-16 text-center">
				<h2 class="mb-4 text-4xl font-bold">What Our Clients Say</h2>
				<div class="mx-auto h-1 w-24 rounded-full bg-brand-600"></div>
			</div>

			<div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
				{
					testimonials.map((t) => (
						<TestimonialCard
							placeholder={t.data.placeholder}
							name={t.data.name}
							rating={t.data.rating}
							quote={t.data.quote}
							project={t.data.project}
							avatar={t.data.avatar}
						/>
					))
				}
			</div>
		</div>
	</section>

	<section class="section relative overflow-hidden bg-gradient-to-br from-brand-600 to-indigo-700">
		<div class="container-page relative z-10 mx-auto max-w-3xl text-center">
			<h2 class="mb-6 text-4xl font-bold text-white md:text-5xl">Ready to Start Your Project?</h2>
			<p class="mb-10 text-xl leading-relaxed text-brand-100">
				Let our engineering team help you bring your custom design to life with precision and confidence.
			</p>
			<div class="flex flex-col justify-center gap-4 sm:flex-row">
				<a href="/get-started" class="btn-secondary px-8 py-4 text-lg font-bold">
					Get in Touch
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" /></svg>
				</a>
				<a href="/process" class="rounded-xl border-2 border-white/30 px-8 py-4 text-lg font-medium text-white transition-all hover:bg-white/10">
					Learn Our Process
				</a>
			</div>
		</div>
	</section>
</Layout>
