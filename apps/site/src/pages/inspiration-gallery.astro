---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

// Placeholder entries (stock/AI-generated images, not verified real
// SynchroBuild projects) are excluded - see src/content.config.ts.
const projects = (await getCollection('projects'))
	.filter((p) => !p.data.placeholder)
	.sort((a, b) => a.data.order - b.data.order);
const categories = ['All', ...new Set(projects.map((p) => p.data.category))];
const hasVerifiedProjects = projects.length > 0;

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: new URL('/', Astro.site).toString(),
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Inspiration Gallery',
			item: new URL('/inspiration-gallery', Astro.site).toString(),
		},
	],
};
---

<Layout
	title="Inspiration Gallery - Synchro Build"
	description={
		hasVerifiedProjects
			? "Explore completed custom homes built with Synchro Build's precision-engineered steel frame systems. Get inspired by real projects showcasing design freedom and quality craftsmanship."
			: 'Our project gallery is coming soon. Contact Synchro Build to discuss your custom-engineered steel frame home.'
	}
	robots={hasVerifiedProjects ? undefined : 'noindex, follow'}
>
	<Fragment slot="head">
		<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
	</Fragment>

	<div class="border-b border-ink-100 bg-ink-50 py-6">
		<div class="container-page">
			<nav aria-label="Breadcrumb">
				<ol class="flex items-center gap-2 text-sm">
					<li><a href="/" class="text-brand-600 hover:text-brand-700">Home</a></li>
					<li class="text-ink-400">/</li>
					<li class="text-ink-600" aria-current="page">Inspiration Gallery</li>
				</ol>
			</nav>
		</div>
	</div>

	<section class="bg-gradient-to-br from-brand-600 to-indigo-700 py-16 text-white">
		<div class="container-page mx-auto max-w-4xl text-center">
			<h1 class="mb-6 text-5xl font-bold text-white md:text-6xl">Inspiration Gallery</h1>
			<p class="text-xl text-brand-100">
				{
					hasVerifiedProjects
						? 'Discover the possibilities of custom engineering. Each project showcases unique designs brought to life with precision-crafted Truecore® steel frame systems.'
						: "We're building our gallery of completed custom-engineered homes. Check back soon."
				}
			</p>
		</div>
	</section>

	<section class="section bg-ink-50">
		<div class="container-page">
			{hasVerifiedProjects ? (
				<>
					<div class="mb-12 flex flex-wrap justify-center gap-3" id="gallery-filters">
						{categories.map((cat) => (
							<button
								type="button"
								data-filter={cat}
								class:list={[
									'filter-btn rounded-full px-6 py-2.5 text-sm font-semibold transition-all duration-200',
									cat === 'All' ? 'bg-brand-600 text-white shadow-md' : 'border border-ink-200 bg-white text-ink-600 hover:bg-ink-100',
								]}
								aria-pressed={cat === 'All'}
							>
								{cat}
							</button>
						))}
					</div>

					<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" id="gallery-grid">
						{projects.map((project) => (
							<div class="gallery-item" data-category={project.data.category}>
								<ProjectCard
									image={project.data.image}
									title={project.data.title}
									category={project.data.category}
									description={project.data.description}
								/>
							</div>
						))}
					</div>
				</>
			) : (
				<div class="rounded-2xl border border-dashed border-ink-200 bg-white py-20 text-center">
					<p class="text-xl font-semibold text-ink-700">Project gallery coming soon.</p>
				</div>
			)}
		</div>
	</section>

	<section class="section bg-white">
		<div class="container-page mx-auto max-w-4xl">
			<div class="rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50 to-indigo-50 p-8 md:p-12">
				<h2 class="mb-6 text-center text-3xl font-bold md:text-4xl">Your Design Could Be Next</h2>
				<p class="mx-auto mb-8 max-w-2xl text-center text-lg text-ink-700">
					{
						hasVerifiedProjects
							? "These homes started as sketches and ideas, just like yours. With Synchro Build's custom engineering, there are no limits to what you can create."
							: "Every home starts as a sketch and an idea, just like yours. With Synchro Build's custom engineering, there are no limits to what you can create."
					}
				</p>
				<!-- TODO(business): "Projects Completed" showed a specific "500+" count
				     on the old site. Not shown until you confirm a real, current number -
				     replace "Ask Us" below with the actual figure when ready. -->
				<div class="mb-8 grid gap-6 text-center md:grid-cols-3">
					<div>
						<div class="mb-2 text-4xl font-bold text-brand-600">100%</div>
						<div class="text-ink-700">Custom Designs</div>
					</div>
					<div>
						<div class="mb-2 text-4xl font-bold text-brand-600">Ask Us</div>
						<div class="text-ink-700">Projects Completed</div>
					</div>
					<div>
						<div class="mb-2 text-4xl font-bold text-brand-600">5 Days</div>
						<div class="text-ink-700">Technical Support</div>
					</div>
				</div>
				<div class="text-center">
					<a href="/get-started" class="btn-primary">Start Your Custom Project</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script>
	const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
	const items = document.querySelectorAll<HTMLDivElement>('.gallery-item');

	filterButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const filter = btn.dataset.filter;

			filterButtons.forEach((b) => {
				b.classList.remove('bg-brand-600', 'text-white', 'shadow-md');
				b.classList.add('border', 'border-ink-200', 'bg-white', 'text-ink-600');
				b.setAttribute('aria-pressed', 'false');
			});
			btn.classList.remove('border', 'border-ink-200', 'bg-white', 'text-ink-600');
			btn.classList.add('bg-brand-600', 'text-white', 'shadow-md');
			btn.setAttribute('aria-pressed', 'true');

			items.forEach((item) => {
				const matches = filter === 'All' || item.dataset.category === filter;
				item.classList.toggle('hidden', !matches);
			});
		});
	});
</script>
