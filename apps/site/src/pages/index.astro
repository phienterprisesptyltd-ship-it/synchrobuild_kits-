---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DesignCalculator from '../components/DesignCalculator.astro';
import { getDesignProcess, getBusiness } from '../lib/content';

const business = await getBusiness();
const designProcess = await getDesignProcess();

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
	.filter((p) => p.data.featured)
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 3);

const features = [
	{ title: '100% Custom Engineering', description: 'Every structural component is engineered from first principles specifically for your project.' },
	{ title: 'Truecore® Steel Materials', description: 'Premium Australian-standard materials engineered for durability and precision.' },
	{ title: 'Nationwide Delivery', description: 'Complete kit delivery to any location across Australia.' },
	{ title: '5-Day Technical Support', description: 'Expert assistance throughout your entire build journey.' },
];
---

<Layout
	title="Synchro Build | 100% Custom-Engineered Building Kits"
	description="100% custom-engineered building kits with precision Truecore® steel materials. From concept to delivery, we engineer your vision with nationwide support across Australia."
>
	<!-- Hero -->
	<section class="relative flex min-h-[90vh] items-center justify-center overflow-hidden">
		<div class="absolute inset-0">
			<img
				src="https://horizons-cdn.hostinger.com/0e3c4b12-5c30-4fff-a4c0-65b7e6df4b83/fc3a3c5be5216ad25773a094c2a3faa8.jpg"
				alt="Modern multi-level dark building with deck nestled in lush tropical forest"
				class="h-full w-full object-cover"
			/>
			<div class="absolute inset-0 bg-gradient-to-b from-black/55 via-black/35 to-black/55"></div>
		</div>

		<div class="relative z-10 container-page pt-40 text-center">
			<h1 class="mx-auto mb-6 max-w-4xl text-4xl font-extrabold text-white drop-shadow-lg md:text-6xl">
				100% Custom-Engineered Building Kits
			</h1>
			<p class="mx-auto mb-8 max-w-3xl text-xl font-medium text-gray-100 drop-shadow-md md:text-2xl">
				Transform your vision into reality with 100% custom-engineered building solutions. Precision-crafted
				materials delivered nationwide.
			</p>
			<div class="flex flex-col justify-center gap-4 sm:flex-row">
				<a href="/process" class="btn-primary px-8 py-4 text-lg shadow-xl">
					Explore Our Process
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" /></svg>
				</a>
				<a href="/get-started" class="btn-secondary px-8 py-4 text-lg shadow-xl">Start Your Project</a>
			</div>
		</div>
	</section>

	<!-- Design services / calculator -->
	<section class="section border-b border-ink-100 bg-ink-50">
		<div class="container-page max-w-5xl">
			<div class="mb-12 text-center">
				<h2 class="mb-6 text-3xl font-extrabold md:text-4xl lg:text-5xl">Design Services</h2>
				<div class="mx-auto max-w-3xl space-y-6">
					<div class="rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50 to-indigo-50 p-8 shadow-sm md:p-10">
						<p class="mb-3 text-2xl leading-tight font-black text-brand-900 md:text-3xl">
							Get a custom design package
						</p>
						<p class="text-lg font-semibold text-brand-800">Contact us for current design-service pricing</p>
					</div>
					<p class="text-xl font-semibold text-ink-800">We design what you want from 1st principles.</p>
					<p class="text-ink-600">
						Designs are based on the land it's going on, its aspect, its features and issues — not based on
						other floor plans as a template.
					</p>
				</div>
			</div>

			<DesignCalculator />
		</div>
	</section>

	<!-- Design process -->
	<section class="section border-b border-ink-100 bg-white">
		<div class="container-page">
			<div class="mb-12 text-center">
				<h2 class="mb-4 text-3xl font-bold md:text-4xl">{designProcess.heading}</h2>
				<p class="mx-auto max-w-2xl text-lg text-ink-600">{designProcess.intro}</p>
			</div>
			<div class="grid gap-6 md:grid-cols-3 lg:grid-cols-5">
				{
					designProcess.steps.map((stage: { id: string; title: string; description: string }) => (
						<div class="flex h-full flex-col rounded-xl border border-ink-100 bg-ink-50 p-6">
							<span class="mb-2 text-xs font-bold tracking-wider text-ink-400">STEP {stage.id}</span>
							<h3 class="mb-2 text-lg font-bold text-ink-900">{stage.title}</h3>
							<p class="flex-grow text-sm leading-relaxed text-ink-600">{stage.description}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Featured projects -->
	<section class="section bg-ink-50">
		<div class="container-page">
			<div class="mb-12 flex flex-col items-end justify-between gap-6 md:flex-row">
				<div class="max-w-2xl">
					<h2 class="mb-4 text-3xl font-bold md:text-4xl">Featured Projects</h2>
					<p class="text-lg text-ink-600">
						Explore a selection of our recently completed custom-engineered homes. Each project demonstrates
						our commitment to precision, quality, and design freedom.
					</p>
				</div>
				<a href="/inspiration-gallery" class="btn-outline flex-shrink-0">
					View Full Gallery
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" /></svg>
				</a>
			</div>

			<div class="mb-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
				{
					featuredProjects.map((project) => (
						<ProjectCard
							image={project.data.image}
							title={project.data.title}
							category={project.data.category}
							description={project.data.description}
						/>
					))
				}
			</div>

			<div class="text-center">
				<a href="/get-started" class="btn-primary px-8 py-4 text-lg">
					Start Your Design
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" /></svg>
				</a>
			</div>
		</div>
	</section>

	<!-- Philosophy -->
	<section class="section bg-white">
		<div class="container-page grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
			<div>
				<h2 class="mb-6 text-3xl font-bold md:text-4xl lg:text-5xl">The Synchro Build Philosophy</h2>
				<div class="space-y-6 text-lg leading-relaxed text-ink-600">
					<p>
						Designing accommodation and homes has been our family passion since {business.foundedYear}. Since
						then, we've built everything from private retreats and wedding venues to hundreds of custom
						cabins and steel-frame structures.
					</p>
					<p>
						For us, the greatest reward is seeing how these spaces transform our clients' lives. We approach
						every new project with excitement, ready to help you bring your dreams to life.
					</p>
					<p>
						Over the years, our family has grown our skills and resources to create a seamless, highly
						synchronized building process that delivers beautiful results every time.
					</p>
				</div>
				<a href="/process" class="btn-primary mt-8 w-full justify-center sm:w-auto">
					Learn More About Our Process
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" /></svg>
				</a>
			</div>

			<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
				{
					features.map((feature) => (
						<div class="rounded-xl border border-ink-100 bg-ink-50 p-6 transition-colors hover:border-brand-100 hover:bg-white">
							<div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-brand-100">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6 text-brand-600">
									<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
								</svg>
							</div>
							<h3 class="mb-2 text-lg font-bold text-ink-900">{feature.title}</h3>
							<p class="text-sm leading-relaxed text-ink-600">{feature.description}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="section relative overflow-hidden bg-gradient-to-br from-brand-600 to-indigo-700">
		<div class="container-page relative z-10 text-center">
			<h2 class="mb-6 text-4xl font-extrabold tracking-tight text-white md:text-5xl">Ready to Build Your Vision?</h2>
			<p class="mx-auto mb-10 max-w-2xl text-xl text-brand-100">
				Let's discuss your project and show you how custom engineering can bring your design to life.
			</p>
			<div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
				<a href="/get-started" class="btn-secondary w-full px-8 py-4 text-lg font-bold sm:w-auto">Get Started</a>
				<a href="/inspiration-gallery" class="w-full rounded-lg border-2 border-white px-8 py-4 text-lg font-semibold text-white transition-all hover:bg-white/10 sm:w-auto">
					View Inspiration Gallery
				</a>
			</div>

			<div class="mt-12 flex flex-col items-center justify-center gap-6 border-t border-brand-500/30 pt-10 text-brand-100 sm:flex-row sm:gap-10">
				<a href={business.phoneHref} class="flex items-center gap-3 rounded-full bg-white/10 px-6 py-3 backdrop-blur-sm">
					<span class="text-lg font-bold text-white">{business.phone}</span>
				</a>
				<a href={`mailto:${business.emailGeneral}`} class="flex items-center gap-3 rounded-full bg-white/10 px-6 py-3 backdrop-blur-sm">
					<span class="text-lg font-bold text-white">{business.emailGeneral}</span>
				</a>
			</div>
		</div>
	</section>
</Layout>
